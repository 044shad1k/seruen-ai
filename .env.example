# Copy to .env and fill in. .env is gitignored and never committed.

# Google AI Studio key for Gemini. Without it the app runs in template mode.
GOOGLE_API_KEY=your-key-here

# Model id is always read from the environment, never hardcoded in the code.
GEMINI_MODEL=gemini-3.8-flash

# 1 = never call the model, answer from retrieval templates only (offline demo).
SERUEN_DEMO=0
